@{
    var title = ViewData["Title"] as string ?? "Toy Shop";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var http = ViewContext.HttpContext;
    var qSection = http.Request.Query["section"].ToString();
    var invSection = string.IsNullOrWhiteSpace(qSection) ? "purchase" : qSection.Trim().ToLowerInvariant();
    if (invSection != "purchase" && invSection != "sales")
    {
        invSection = "purchase";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Toy Shop Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="ts-app">
        <aside class="ts-sidebar">
            <div class="ts-brand">
                <div class="ts-brand__logo" aria-hidden="true"></div>
                <div class="ts-brand__text">
                    <div class="ts-brand__title">Toy Shop</div>
                    <div class="ts-brand__subtitle">Management</div>
                </div>
            </div>

            <nav class="ts-nav" aria-label="Main navigation">
                @if (User.IsInRole("Admin"))
                {
                    <a class="ts-nav__link" asp-controller="Portal" asp-action="Dashboard" data-nav="tab" aria-current='@(currentAction == "Dashboard" ? "page" : null)'>
                        <span class="ts-nav__icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 10.5L12 3L21 10.5V21H3V10.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                <path d="M9 21V12H15V21" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <span class="ts-nav__text">Dashboard</span>
                    </a>
                }
                @if (User.IsInRole("Cashier"))
                {
                    <a class="ts-nav__link" asp-controller="Portal" asp-action="Pos" data-nav="tab" aria-current='@(currentAction == "Pos" ? "page" : null)'>
                        <span class="ts-nav__icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M7 7H17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M7 12H17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M7 17H13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M6 3H18C19.1 3 20 3.9 20 5V19C20 20.1 19.1 21 18 21H6C4.9 21 4 20.1 4 19V5C4 3.9 4.9 3 6 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <span class="ts-nav__text">POS</span>
                    </a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <div class="ts-nav-group @((currentAction == "Inventory" || currentAction == "Products") ? "is-open" : "")" data-nav-group="inventory">
                        <button type="button"
                                class="ts-nav__link ts-nav__link--parent @((currentAction == "Inventory" || currentAction == "Products") ? "is-active" : "")"
                                data-nav-parent-toggle
                                aria-expanded="@((currentAction == "Inventory" || currentAction == "Products") ? "true" : "false")"
                                aria-controls="navInventorySub"
                                id="navInventoryParent">
                            <span class="ts-nav__icon" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12 2L22 7L12 12L2 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                    <path d="M22 7V17L12 22L2 17V7" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                </svg>
                            </span>
                            <span class="ts-nav__text">Inventory</span>
                            <span class="ts-nav__chevron" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                        </button>
                        <div class="ts-nav__sub" id="navInventorySub" role="group" aria-labelledby="navInventoryParent">
                            <a class="ts-nav__link ts-nav__link--sub"
                               asp-controller="Portal"
                               asp-action="Products"
                               data-nav="tab"
                               aria-current='@(currentAction == "Products" ? "page" : null)'>
                                <span class="ts-nav__text">Product Entry</span>
                            </a>
                            <a class="ts-nav__link ts-nav__link--sub"
                               asp-controller="Portal"
                               asp-action="Inventory"
                               asp-route-section="purchase"
                               data-nav="tab"
                               aria-current='@(currentAction == "Inventory" && invSection == "purchase" ? "page" : null)'>
                                <span class="ts-nav__text">Stock In</span>
                            </a>
                            <a class="ts-nav__link ts-nav__link--sub"
                               asp-controller="Portal"
                               asp-action="Products"
                               data-nav="tab"
                               aria-current="@(currentAction == "Products" ? "page" : null)">
                                <span class="ts-nav__text">Stock Check</span>
                            </a>
                            <a class="ts-nav__link ts-nav__link--sub"
                               asp-controller="Portal"
                               asp-action="Inventory"
                               asp-route-section="sales"
                               data-nav="tab"
                               aria-current='@(currentAction == "Inventory" && invSection == "sales" ? "page" : null)'>
                                <span class="ts-nav__text">Returns</span>
                            </a>
                        </div>
                    </div>
                }
                <a class="ts-nav__link" asp-controller="Portal" asp-action="Reports" data-nav="tab" aria-current='@(currentAction == "Reports" ? "page" : null)'>
                    <span class="ts-nav__icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M4 19H20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M6 17V11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M12 17V7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M18 17V13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </span>
                    <span class="ts-nav__text">Sales History</span>
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="ts-nav__link" asp-controller="Portal" asp-action="Customers" data-nav="tab" aria-current='@(currentAction == "Customers" ? "page" : null)'>
                        <span class="ts-nav__icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M16 21V19C16 17.3431 14.6569 16 13 16H7C5.34315 16 4 17.3431 4 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M10 11C12.2091 11 14 9.20914 14 7C14 4.79086 12.2091 3 10 3C7.79086 3 6 4.79086 6 7C6 9.20914 7.79086 11 10 11Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                <path d="M20 21V19C20 17.8954 19.5523 16.8954 18.8284 16.1716" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M16 3.16399C17.6953 3.69373 19 5.25874 19 7C19 8.74126 17.6953 10.3063 16 10.836" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </span>
                        <span class="ts-nav__text">Customers</span>
                    </a>
                    <a class="ts-nav__link ts-nav__link--admin" asp-controller="Portal" asp-action="Staff" data-nav="tab" aria-current='@(currentAction == "Staff" ? "page" : null)'>
                        <span class="ts-nav__icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M16 21V19C16 17.3431 14.6569 16 13 16H7C5.34315 16 4 17.3431 4 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M10 11C12.2091 11 14 9.20914 14 7C14 4.79086 12.2091 3 10 3C7.79086 3 6 4.79086 6 7C6 9.20914 7.79086 11 10 11Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                <path d="M20 8V12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M18 10H22" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </span>
                        <span class="ts-nav__text">Staff</span>
                    </a>
                }
            </nav>

            <div class="ts-sidebar__footer">
                <div class="ts-user">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <div class="ts-user__row">
                            <div class="ts-user__info">
                                <span class="ts-user__label">Hello,</span>
                                <span class="ts-user__name">@User.Identity!.Name</span>
                            </div>
                            <a asp-controller="Account" asp-action="Logout" class="ts-logout-btn" title="Sign Out">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M9 21H5C4.46957 21 3.96086 20.7893 3.58579 20.4142C3.21071 20.0391 3 19.5304 3 19V5C3 4.46957 3.21071 3.96086 3.58579 3.58579C3.96086 3.21071 4.46957 3 5 3H9" />
                                    <polyline points="16 17 21 12 16 7" />
                                    <line x1="21" y1="12" x2="9" y2="12" />
                                </svg>
                                <span class="ts-logout-label">Logout</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="ts-user__row">
                            <span class="ts-user__label">Not logged in</span>
                        </div>
                    }
                </div>
            </div>
        </aside>

        <section class="ts-content">
            <header class="ts-app-topbar" role="banner">
                <button type="button"
                        id="tsMobileToggle"
                        class="ts-topbar__hamburger"
                        aria-label="Open navigation menu"
                        aria-expanded="false"
                        title="Menu">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M4 7H20M4 12H20M4 17H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </button>
                <div class="ts-app-topbar__title">@title</div>
            </header>
            <main class="ts-main">
                <div class="ts-page ts-anim-in">
                    @RenderBody()
                </div>
            </main>
        </section>
    </div>

    <script>
        (function () {
            const body = document.body;
            const main = document.querySelector('main.ts-main');
            if (!main) return;
            const pendingSpaForms = new WeakSet();

            function captureScrollState() {
                const state = {
                    winY: window.scrollY || 0,
                    byId: {},
                    tableScrollTops: [],
                    byKey: {}
                };
                try {
                    const curPage = main.querySelector('.ts-page');
                    if (!curPage) return state;

                    // Preserve scroll for any scrollable elements that have ids (most stable key).
                    curPage.querySelectorAll('[id]').forEach(function (el) {
                        try {
                            if (!el) return;
                            const st = el.scrollTop || 0;
                            if (st > 0) state.byId[el.id] = st;
                        } catch { }
                    });

                    // Preserve scroll for marked containers (stable across swaps).
                    curPage.querySelectorAll('[data-preserve-scroll]').forEach(function (el) {
                        try {
                            const key = el.getAttribute('data-preserve-scroll');
                            if (!key) return;
                            state.byKey[key] = el.scrollTop || 0;
                        } catch { }
                    });

                    // Also preserve for common scroll containers by index (fallback).
                    curPage.querySelectorAll('.ts-table-scroll').forEach(function (el) {
                        try { state.tableScrollTops.push(el.scrollTop || 0); } catch { state.tableScrollTops.push(0); }
                    });
                } catch { }
                return state;
            }

            function restoreScrollState(nextRoot, state) {
                if (!state) return;
                try {
                    // Restore window scroll first (prevents visible jump while restoring inner scrolls).
                    if (typeof state.winY === 'number') window.scrollTo(0, state.winY);
                } catch { }

                try {
                    if (nextRoot && state.byId) {
                        Object.keys(state.byId).forEach(function (id) {
                            const el = nextRoot.querySelector('#' + CSS.escape(id));
                            if (el) el.scrollTop = state.byId[id];
                        });
                    }
                } catch { }

                try {
                    if (nextRoot && state.byKey) {
                        Object.keys(state.byKey).forEach(function (key) {
                            const el = nextRoot.querySelector('[data-preserve-scroll="' + CSS.escape(key) + '"]');
                            if (el) el.scrollTop = state.byKey[key];
                        });
                    }
                } catch { }

                try {
                    if (nextRoot && Array.isArray(state.tableScrollTops) && state.tableScrollTops.length) {
                        const els = nextRoot.querySelectorAll('.ts-table-scroll');
                        for (let i = 0; i < els.length && i < state.tableScrollTops.length; i++) {
                            els[i].scrollTop = state.tableScrollTops[i];
                        }
                    }
                } catch { }
            }

            function captureFocusState() {
                try {
                    const curPage = main.querySelector('.ts-page');
                    const a = document.activeElement;
                    if (!curPage || !a || !curPage.contains(a)) return null;
                    const tag = (a.tagName || '').toLowerCase();
                    const id = a.id || '';
                    const name = a.getAttribute ? (a.getAttribute('name') || '') : '';
                    const key = a.getAttribute ? (a.getAttribute('data-focus-key') || '') : '';
                    let sel = null;
                    if (a instanceof HTMLInputElement || a instanceof HTMLTextAreaElement) {
                        try {
                            sel = {
                                start: typeof a.selectionStart === 'number' ? a.selectionStart : null,
                                end: typeof a.selectionEnd === 'number' ? a.selectionEnd : null
                            };
                        } catch { }
                    }
                    return { tag, id, name, key, sel };
                } catch {
                    return null;
                }
            }

            function restoreFocusState(nextRoot, focusState) {
                if (!nextRoot || !focusState) return;
                try {
                    let el = null;
                    if (focusState.id) el = nextRoot.querySelector('#' + CSS.escape(focusState.id));
                    if (!el && focusState.key) el = nextRoot.querySelector('[data-focus-key="' + CSS.escape(focusState.key) + '"]');
                    if (!el && focusState.name) el = nextRoot.querySelector(focusState.tag + '[name="' + CSS.escape(focusState.name) + '"]');
                    if (!el) return;
                    if (el.focus) el.focus({ preventScroll: true });
                    if (focusState.sel && (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement)) {
                        const s = focusState.sel.start;
                        const e = focusState.sel.end;
                        if (typeof s === 'number' && typeof e === 'number') {
                            try { el.setSelectionRange(s, e); } catch { }
                        }
                    }
                } catch { }
            }

            function executeScripts(container) {
                if (!container) return;
                container.querySelectorAll('script').forEach(function (old) {
                    try {
                        const s = document.createElement('script');
                        if (old.src) {
                            s.src = old.src;
                            if (old.async) s.async = true;
                            if (old.defer) s.defer = true;
                        } else {
                            s.textContent = old.textContent;
                        }
                        old.parentNode.replaceChild(s, old);
                    } catch (err) {
                        console.error('executeScripts error for script:', old, err);
                    }
                });
            }

            function isPosCartAction(form) {
                return false; /* Disable right-only, we do a smooth 2-column swap for everything */
            }

            function mountPosRightPanelOnly(html) {
                return false;
            }

            function mountFragmentHtml(html, opts) {
                const options = opts || {};
                const preserveScroll = !!options.preserveScroll;
                const scrollState = preserveScroll ? captureScrollState() : null;
                const focusState = preserveScroll ? captureFocusState() : null;
                const curPageForLock = preserveScroll ? main.querySelector('.ts-page') : null;
                let lockedHeight = null;
                try {
                    if (curPageForLock) {
                        const r = curPageForLock.getBoundingClientRect();
                        lockedHeight = Math.max(0, Math.round(r.height));
                        if (lockedHeight > 0) {
                            curPageForLock.style.minHeight = lockedHeight + 'px';
                        }
                    }
                } catch { }

                const doc = new DOMParser().parseFromString(html, 'text/html');
                const root = doc.querySelector('#ts-fragment-root') || doc.body.firstElementChild;
                if (!root) { main.innerHTML = html; return; }

                const imported = document.importNode(root, true);
                if (preserveScroll) {
                    imported.classList.remove('ts-anim-in');
                    imported.classList.add('ts-page--spa-swap');
                }
                const curPage = main.querySelector('.ts-page');
                
                if (curPage) {
                    const curMain = curPage.querySelector('.ts-shell-main');
                    const curSide = curPage.querySelector('.ts-shell-side');
                    const newMain = imported.querySelector('.ts-shell-main');
                    const newSide = imported.querySelector('.ts-shell-side');

                    if (preserveScroll && curMain && curSide && newMain && newSide) {
                        curMain.replaceWith(newMain);
                        curSide.replaceWith(newSide);
                        try {
                            executeScripts(main.querySelector('.ts-page'));
                        } catch (e) {
                            console.error('executeScripts failed:', e);
                        }
                    } else {
                        curPage.replaceWith(imported);
                        try {
                            executeScripts(imported);
                        } catch (e) {
                            console.error('executeScripts failed on imported:', e);
                        }
                    }
                } else {
                    main.innerHTML = '';
                    main.appendChild(imported);
                    executeScripts(imported);
                }
                if (preserveScroll) {
                    // Restore scroll after DOM replacement and scripts have run.
                    restoreScrollState(imported, scrollState);
                    restoreFocusState(imported, focusState);
                }
                // Release height lock on next frame to avoid visible jump.
                try {
                    requestAnimationFrame(function () {
                        imported.style.minHeight = '';
                    });
                } catch { }
            }

            function updateNavActive() {
                const cur = new URL(window.location.href);
                document.querySelectorAll('a[data-nav="tab"]').forEach(function (a) {
                    try {
                        const u = new URL(a.href);
                        if (u.pathname !== cur.pathname) {
                            a.removeAttribute('aria-current');
                            return;
                        }
                        const invPath = /\/inventory$/i.test(u.pathname);
                        if (invPath) {
                            const secA = (u.searchParams.get('section') || 'purchase').toLowerCase();
                            const secCur = (cur.searchParams.get('section') || 'purchase').toLowerCase();
                            if (secA === secCur) {
                                a.setAttribute('aria-current', 'page');
                            } else {
                                a.removeAttribute('aria-current');
                            }
                            return;
                        }
                        a.setAttribute('aria-current', 'page');
                    } catch {
                        a.removeAttribute('aria-current');
                    }
                });
            }

            function syncNavGroups() {
                const cur = new URL(window.location.href);
                const isInv = /\/inventory$/i.test(cur.pathname) || /\/products$/i.test(cur.pathname);
                document.querySelectorAll('[data-nav-group="inventory"]').forEach(function (g) {
                    const btn = g.querySelector('[data-nav-parent-toggle]');
                    if (isInv) {
                        g.classList.add('is-open');
                        if (btn) {
                            btn.setAttribute('aria-expanded', 'true');
                            btn.classList.add('is-active');
                        }
                    } else {
                        g.classList.remove('is-open');
                        if (btn) {
                            btn.setAttribute('aria-expanded', 'false');
                            btn.classList.remove('is-active');
                        }
                    }
                });
            }

            function swapNavContent(href) {
                const fetchUrl = new URL(href, window.location.origin);
                return fetch(fetchUrl.toString(), {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-SPA-Fragment': '1',
                        'Accept': 'text/html'
                    }
                }).then(function (res) {
                    if (!res.ok) throw new Error('nav fetch failed');
                    return res.text();
                }).then(function (html) {
                    mountFragmentHtml(html, { preserveScroll: false });
                    const root = main.querySelector('#ts-fragment-root');
                    if (root && root.dataset.pageTitle) {
                        document.title = root.dataset.pageTitle + ' - Toy Shop Management';
                    }
                });
            }

            const mobileBtn = document.getElementById('tsMobileToggle');
            if (mobileBtn) {
                mobileBtn.addEventListener('click', function () {
                    body.classList.toggle('ts-mobile-nav-open');
                    const open = body.classList.contains('ts-mobile-nav-open');
                    mobileBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
            }

            document.addEventListener('click', function (e) {
                if (!body.classList.contains('ts-mobile-nav-open')) return;
                const sidebar = document.querySelector('.ts-sidebar');
                if (!sidebar) return;
                if (sidebar.contains(e.target)) return;
                if (mobileBtn && mobileBtn.contains(e.target)) return;
                body.classList.remove('ts-mobile-nav-open');
            });

            document.querySelectorAll('a[data-nav="tab"]').forEach(function (a) {
                a.addEventListener('click', function (e) {
                    if (e.defaultPrevented) return;
                    if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
                    const href = a.getAttribute('href');
                    if (!href || href === '#') return;
                    e.preventDefault();
                    swapNavContent(href).then(function () {
                        const clean = new URL(href, window.location.origin);
                        history.pushState({ spa: true }, '', clean.pathname + clean.search);
                        updateNavActive();
                        syncNavGroups();
                        body.classList.remove('ts-mobile-nav-open');
                        window.scrollTo(0, 0);
                    }).catch(function () {
                        window.location.href = href;
                    });
                });
            });

            window.addEventListener('popstate', function () {
                swapNavContent(window.location.href).then(function () {
                    updateNavActive();
                    syncNavGroups();
                    window.scrollTo(0, 0);
                }).catch(function () {
                    window.location.reload();
                });
            });

            document.querySelectorAll('[data-nav-parent-toggle]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const g = btn.closest('.ts-nav-group');
                    if (!g) return;
                    g.classList.toggle('is-open');
                    const open = g.classList.contains('is-open');
                    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
            });

            syncNavGroups();

            /* POS / in-page forms: POST without full reload */
            document.addEventListener('submit', function (e) {
                const form = e.target;
                if (!(form instanceof HTMLFormElement)) return;
                if (!form.hasAttribute('data-spa-form')) return;
                if (pendingSpaForms.has(form)) {
                    e.preventDefault();
                    return;
                }
                /* POS: name search is client-side only (Pos.cshtml); do not POST fragment if input is not a barcode. */
                if (form.id === 'posSearchForm') {
                    const input = document.getElementById('posSearchInput');
                    if (input) {
                        const v = (input.value || '').trim();
                        if (v) {
                            const digits = v.replace(/\D/g, '');
                            const looksLikeBarcode = /^[\d\s\-\.]+$/.test(v) && digits.length >= 4;
                            if (!looksLikeBarcode) {
                                e.preventDefault();
                                return;
                            }
                        }
                    }
                }
                e.preventDefault();
                pendingSpaForms.add(form);
                const fd = new FormData(form);
                const usp = new URLSearchParams();
                fd.forEach(function(value, key) {
                    usp.append(key, value);
                });
                
                const action = form.action || window.location.href;
                const method = (form.getAttribute('method') || 'POST').toUpperCase();
                fetch(action, {
                    method: method,
                    body: usp,
                    credentials: 'same-origin',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-SPA-Fragment': '1',
                        'Accept': 'application/json, text/html;q=0.9'
                    }
                }).then(function (res) {
                    const ct = res.headers.get('Content-Type') || '';
                    if (ct.indexOf('application/json') !== -1) {
                        return res.json().then(function (data) {
                            if (data && data.redirect) {
                                window.location.href = data.redirect;
                                return;
                            }
                            throw new Error('unexpected json');
                        });
                    }
                    if (!res.ok) {
                        return res.text().then(function (errTxt) {
                            let errTitle = errTxt.substring(0, 100) + '...';
                            try {
                                const m = errTxt.match(/<title>([^<]+)<\/title>/i);
                                if (m && m[1]) errTitle = m[1].trim();
                            } catch (e) { }
                            throw new Error('HTTP ' + res.status + ' - ' + errTitle);
                        });
                    }
                    return res.text();
                }).then(function (html) {
                    if (typeof html !== 'string') return;
                    if (isPosCartAction(form) && mountPosRightPanelOnly(html)) {
                        return;
                    }
                    mountFragmentHtml(html, { preserveScroll: true });
                    const root = main.querySelector('#ts-fragment-root');
                    if (root && root.dataset.pageTitle) {
                        document.title = root.dataset.pageTitle + ' - Toy Shop Management';
                    }
                }).catch(function (err) {
                    console.error('SPA form error:', err);
                    alert('SPA Error: ' + err.message);
                }).finally(function () {
                    pendingSpaForms.delete(form);
                });
            });

            /* In-page GET (e.g. POS Cancel) */
            document.addEventListener('click', function (e) {
                const a = e.target.closest('a[data-spa-get]');
                if (!a) return;
                if (e.defaultPrevented) return;
                if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
                const href = a.getAttribute('href');
                if (!href || href === '#') return;
                e.preventDefault();
                const fetchUrl = new URL(href, window.location.origin);
                fetch(fetchUrl.toString(), {
                    credentials: 'same-origin',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'text/html',
                        'X-SPA-Fragment': '1'
                    }
                }).then(function (res) {
                    if (!res.ok) throw new Error('spa get failed');
                    return res.text();
                }).then(function (html) {
                    mountFragmentHtml(html, { preserveScroll: true });
                    const root = main.querySelector('#ts-fragment-root');
                    if (root && root.dataset.pageTitle) {
                        document.title = root.dataset.pageTitle + ' - Toy Shop Management';
                    }
                }).catch(function () {
                    window.location.href = href;
                });
            });

            window.addEventListener('pageshow', function () {
                body.classList.remove('ts-nav-leave');
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

