@model Children_s_toy_shop_management_software.Models.Customers.CustomersPageVm

<div class="ts-shell-page">
    <div class="ts-shell-toolbar">
        <form method="get"
              asp-action="Customers"
              asp-controller="Portal">
            <div class="ts-shell-toolbar__row">
                <div style="flex:1; min-width:240px;">
                    <label class="ts-card__sub" style="display:block; margin-bottom:6px;">Search</label>
                    <input class="form-control" name="search" value="@Model.Search" placeholder="Search by name or phone..." />
                </div>
                <button type="submit" class="btn btn-primary">Apply</button>
            </div>
        </form>
    </div>

    <div class="ts-shell-layout">
        <div class="ts-shell-main ts-card" style="padding:14px;">
        <div class="ts-table-scroll">
            <table class="table table-dark table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:70px;">ID</th>
                        <th>Name</th>
                        <th style="width:160px;">Phone</th>
                        <th style="width:200px;">Total spent</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Customers)
                    {
                        var isSelected = Model.SelectedCustomer?.Id == c.Id;
                        <tr class="@(isSelected ? "table-primary" : "")">
                            <td>
                                <a asp-action="Customers" asp-controller="Portal"
                                   asp-route-id="@c.Id"
                                   asp-route-search="@Model.Search"
                                   class="text-decoration-none text-light">
                                    @c.Id
                                </a>
                            </td>
                            <td>@c.FullName</td>
                            <td>@c.Phone</td>
                            <td>@c.TotalSpent.ToString("N0") ₫</td>
                        </tr>
                    }
                    @if (Model.Customers.Count == 0)
                    {
                        <tr>
                            <td colspan="4" style="color:rgba(255,255,255,.7);">No customers found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </div>

    <div class="ts-shell-side ts-card" style="padding:14px;">
        @if (Model.SelectedCustomer == null)
        {
            <div class="ts-shell-empty ts-placeholder" style="height:min(420px, 55vh); border:none; background:transparent;">
                <div style="font-weight:900; color:rgba(255,255,255,.85);">Select a customer</div>
            </div>
        }
        else
        {
            <div class="ts-card__title" style="margin-bottom:10px;">Customer details</div>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                <div class="ts-kpi" style="padding:12px;">
                    <div class="ts-kpi__label">Full name</div>
                    <div class="ts-kpi__value" style="font-size:16px;">@Model.SelectedCustomer.FullName</div>
                </div>
                <div class="ts-kpi" style="padding:12px;">
                    <div class="ts-kpi__label">Points</div>
                    <div class="ts-kpi__value" style="font-size:16px;">@Model.SelectedCustomer.Points.ToString("N0")</div>
                </div>
                <div class="ts-kpi" style="padding:12px;">
                    <div class="ts-kpi__label">Phone</div>
                    <div class="ts-kpi__value" style="font-size:16px;">@Model.SelectedCustomer.Phone</div>
                </div>
                <div class="ts-kpi" style="padding:12px;">
                    <div class="ts-kpi__label">Address</div>
                    <div class="ts-kpi__value" style="font-size:16px;">@Model.SelectedCustomer.Address</div>
                </div>
            </div>

            <div style="height:14px;"></div>

            <div class="ts-card" style="padding:14px; background: rgba(255,255,255,.03);">
                <div class="ts-card__title" style="font-size:14px; margin-bottom:6px;">Order history</div>

                <div style="max-height:340px; overflow:auto; border-radius:16px;">
                    <table class="table table-dark table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:90px;">Order ID</th>
                                <th style="width:150px;">Date</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.Orders)
                            {
                                <tr>
                                    <td>@o.OrderId</td>
                                    <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@o.TotalAmount.ToString("N0") ₫</td>
                                </tr>
                            }
                            @if (Model.Orders.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" style="color:rgba(255,255,255,.7);">No orders found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
    </div>
</div>

