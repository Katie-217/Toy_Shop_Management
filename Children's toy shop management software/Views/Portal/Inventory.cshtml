@model Children_s_toy_shop_management_software.Models.Inventory.InventoryPageVm

@{
    var sec = (Model.Section ?? "purchase").ToLower();

    var isPurchase = sec == "purchase";
    var isReturn = sec == "return";
    var isSales = sec == "sales";

    var pageTitle = isPurchase ? "📦 Stock In Management"
                  : isReturn ? "↩ Return Management"
                  : "📤 Stock Out Management";

    var pageDesc = isPurchase ? "Create purchase orders / Restock products / Update inventory"
                 : isReturn ? "Manage returned products / Supplier returns / Adjust stock"
                 : "Manage sold products / Reduce stock / Export inventory";

    var btnText = isPurchase ? "+ New Stock In"
               : isReturn ? "+ New Return"
               : "+ New Stock Out";

    var formTitle = Model.Form.MovementId.HasValue
        ? (isPurchase ? "✏ Edit Stock In Order"
        : isReturn ? "✏ Edit Return Order"
        : "✏ Edit Stock Out Order")
        : (isPurchase ? "➕ Create Stock In Order"
        : isReturn ? "➕ Create Return Order"
        : "➕ Create Stock Out Order");

    var saveText = isPurchase ? "💾 Save Stock In Order"
                : isReturn ? "💾 Save Return Order"
                : "💾 Save Stock Out Order";

    var historyTitle = isPurchase ? "📋 Stock In History"
                     : isReturn ? "📋 Return History"
                     : "📋 Stock Out History";

    var emptyText = isPurchase ? "No stock in records found"
                  : isReturn ? "No return records found"
                  : "No stock out records found";

    var noteLabel = isPurchase ? "Supplier / Note"
                 : isReturn ? "Return Reason / Supplier"
                 : "Customer / Note";

    var notePlaceholder = isPurchase ? "Supplier name / order note..."
                       : isReturn ? "Return reason..."
                       : "Customer / export note...";

    var buttonColor = isPurchase ? "success"
                    : isReturn ? "warning"
                    : "danger";
}

<div class="container-fluid py-3">

    <!-- HEADER -->
    <div class="card bg-dark text-white border-0 shadow-sm mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h3 class="mb-1">@pageTitle</h3>
                <small class="text-light opacity-75">@pageDesc</small>
            </div>

            <a class="btn btn-outline-light"
                   asp-action="Inventory"
                   asp-controller="Portal"
                   asp-route-section="@sec">
                @btnText
            </a>
        </div>
    </div>

    <div class="row g-3">

        <!-- LEFT -->
        <div class="col-lg-7">
            <div class="card bg-dark text-white border-0 shadow-sm">
                <div class="card-body">

                    <form method="get" asp-action="Inventory" asp-controller="Portal">
                        <input type="hidden" name="section" value="@sec" />

                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <label class="small mb-1">From</label>
                                <input class="form-control" type="date"
                                       name="from"
                                       value="@Model.From.ToString("yyyy-MM-dd")" />
                            </div>

                            <div class="col-md-4">
                                <label class="small mb-1">To</label>
                                <input class="form-control" type="date"
                                       name="to"
                                       value="@Model.To.ToString("yyyy-MM-dd")" />
                            </div>

                            <div class="col-md-4">
                                <label class="small mb-1">Search</label>
                                <input class="form-control"
                                       name="q"
                                       value="@Model.Q"
                                       placeholder="Note / ID..." />
                            </div>
                        </div>

                        <button class="btn btn-primary w-100">
                            Apply Filter
                        </button>
                    </form>

                    <hr class="border-secondary" />

                    <h5 class="mb-3">@historyTitle</h5>

                    <div style="max-height:600px;overflow:auto;">
                        <table class="table table-dark table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Date</th>
                                    <th>Items</th>
                                    <th>Total Qty</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var m in Model.Movements)
                                {
                                    <tr>
                                        <td>#@m.MovementId</td>
                                        <td>@m.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@m.LineCount</td>
                                        <td>@m.TotalQty</td>
                                        <td>
                                            <a class="btn btn-sm btn-outline-info"
                                                   asp-action="Inventory"
                                                   asp-controller="Portal"
                                                   asp-route-id="@m.MovementId"
                                                   asp-route-section="@sec">
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                }

                                @if (Model.Movements.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-secondary">
                                            @emptyText
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>

        <!-- RIGHT -->
        <div class="col-lg-5">
            <div class="card bg-dark text-white border-0 shadow-sm">
                <div class="card-body">

                    <h4 class="mb-3">@formTitle</h4>

                    <form method="post"
                          asp-action="InventorySave"
                          asp-controller="Portal"
                          asp-route-section="@sec"
                          id="inventoryForm">

                        <input type="hidden" asp-for="Form.MovementId" />
                        <input type="hidden" asp-for="Form.MovementType"
                               value="@(isPurchase ? "IN" : "OUT")" />
                        <input type="hidden" asp-for="Form.AffectsStock" value="true" />

                        <div class="mb-3">
                            <label class="small mb-1">Date</label>
                            <input class="form-control"
                                   asp-for="Form.CreatedAt"
                                   type="datetime-local" />
                        </div>

                        <div class="mb-3">
                            <label class="small mb-1">@noteLabel</label>
                            <input class="form-control"
                                   asp-for="Form.Note"
                                   placeholder="@notePlaceholder" />
                        </div>

                        <div class="table-responsive mb-3" style="max-height:420px;overflow:auto;">
                            <table class="table table-dark align-middle">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th width="90">Qty</th>
                                        <th width="130">Price</th>
                                        <th width="40"></th>
                                    </tr>
                                </thead>

                                <tbody id="lineItemsContainer">
                                    @for (int i = 0; i < Model.Form.Lines.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <select class="form-select"
                                                        asp-for="Form.Lines[i].ProductId">
                                                    @foreach (var p in Model.Products)
                                                    {
                                                        <option value="@p.ProductId">
                                                            @p.Name (@p.Barcode)
                                                        </option>
                                                    }
                                                </select>
                                            </td>

                                            <td>
                                                <input class="form-control qty"
                                                       asp-for="Form.Lines[i].Quantity"
                                                       type="number"
                                                       min="1" />
                                            </td>

                                            <td>
                                                <input class="form-control price"
                                                       asp-for="Form.Lines[i].UnitPrice"
                                                       type="number"
                                                       step="0.01" />
                                            </td>

                                            <td>
                                                <button type="button"
                                                        class="btn btn-sm btn-danger"
                                                        onclick="removeLine(this)">
                                                    X
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <button type="button"
                                class="btn btn-outline-info w-100 mb-3"
                                onclick="addLineItem()">
                            + Add Product
                        </button>

                        <div class="bg-secondary rounded p-3 mb-3">
                            <div class="d-flex justify-content-between">
                                <span>Total Quantity:</span>
                                <strong id="totalQty">0</strong>
                            </div>

                            <div class="d-flex justify-content-between mt-2">
                                <span>Total Amount:</span>
                                <strong id="totalCost">0</strong>
                            </div>
                        </div>

                        <button class="btn btn-@buttonColor w-100">
                            @saveText
                        </button>

                    </form>

                    @if (!string.IsNullOrWhiteSpace(Model.Error))
                    {
                        <div class="alert alert-danger mt-3">
                            @Model.Error
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>
</div>

<script>
    let lineIdx = @Model.Form.Lines.Count;

    function addLineItem() {

        let options = '';

        @foreach (var p in Model.Products)
            {
                @:options += `<option value="@p.ProductId">@p.Name (@p.Barcode)</option>`;
        }

        const row = document.createElement("tr");

        row.innerHTML = `
            <td>
                <select name="Form.Lines[${lineIdx}].ProductId" class="form-select">
                    ${options}
                </select>
            </td>

            <td>
                <input name="Form.Lines[${lineIdx}].Quantity"
                       class="form-control qty"
                       type="number"
                       value="1"
                       min="1"
                       oninput="calcTotal()">
            </td>

            <td>
                <input name="Form.Lines[${lineIdx}].UnitPrice"
                       class="form-control price"
                       type="number"
                       value="0"
                       step="0.01"
                       oninput="calcTotal()">
            </td>

            <td>
                <button type="button"
                        class="btn btn-sm btn-danger"
                        onclick="removeLine(this)">
                    X
                </button>
            </td>
        `;

        document.getElementById("lineItemsContainer").appendChild(row);
        lineIdx++;
        calcTotal();
    }

    function removeLine(btn) {
        btn.closest("tr").remove();
        calcTotal();
    }

    function calcTotal() {

        let qty = 0;
        let total = 0;

        document.querySelectorAll("#lineItemsContainer tr").forEach(row => {

            let q = parseFloat(row.querySelector(".qty")?.value || 0);
            let p = parseFloat(row.querySelector(".price")?.value || 0);

            qty += q;
            total += q * p;
        });

        document.getElementById("totalQty").innerText = qty;
        document.getElementById("totalCost").innerText = total.toLocaleString();
    }

    document.addEventListener("input", calcTotal);
    window.onload = calcTotal;
</script>
