@model Children_s_toy_shop_management_software.Models.Inventory.InventoryPageVm

@section Styles {
    <link rel="stylesheet" href="~/css/tabs/Inventory/inventory.css" asp-append-version="true" />
}

<div class="ts-shell-page">

    <div class="ts-shell-toolbar">

        <form method="get"

              asp-action="Inventory"

              asp-controller="Portal">

            <input type="hidden" name="section" value="@Model.Section" />

            <div class="row g-2 align-items-end">

                <div class="col-md-4">

                    <label class="ts-card__sub" style="display:block; margin-bottom:6px;">From</label>

                    <input class="form-control" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />

                </div>

                <div class="col-md-4">

                    <label class="ts-card__sub" style="display:block; margin-bottom:6px;">To</label>

                    <input class="form-control" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" />

                </div>

                <div class="col-md-3">

                    <label class="ts-card__sub" style="display:block; margin-bottom:6px;">Search</label>

                    <input class="form-control" name="q" value="@Model.Q" placeholder="Note or ID..." />

                </div>

                <div class="col-md-1 d-grid">

                    <button type="submit" class="btn btn-primary">Apply</button>

                </div>

            </div>

            <div style="height:10px;"></div>

            <a class="btn btn-outline-light btn-sm"

               asp-action="Inventory"

               asp-controller="Portal"

               asp-route-section="@Model.Section">

                Reset

            </a>

        </form>

    </div>



    <div class="ts-shell-layout">

        <div class="ts-shell-main ts-card" style="padding:14px;">

        <div class="ts-table-scroll">

            <table class="table table-dark table-sm align-middle mb-0">

                <thead>

                    <tr>

                        <th style="width:90px;">ID</th>

                        <th style="width:140px;">Date</th>

                        <th style="width:90px;">Type</th>

                        <th style="width:80px;">Lines</th>

                        <th>Total qty</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var m in Model.Movements)

                    {

                        var isSelected = Model.SelectedMovement?.MovementId == m.MovementId;

                        <tr class="@(isSelected ? "table-primary" : "")">

                            <td>

                                <a asp-action="Inventory"

                                   asp-controller="Portal"

                                   asp-route-id="@m.MovementId"

                                   asp-route-from="@Model.From.ToString("yyyy-MM-dd")"

                                   asp-route-to="@Model.To.ToString("yyyy-MM-dd")"

                                   asp-route-section="@Model.Section"

                                   asp-route-q="@Model.Q"

                                   class="text-decoration-none text-light">

                                    @m.MovementId

                                </a>

                            </td>

                            <td>@m.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>

                            <td>@m.MovementType</td>

                            <td>@m.LineCount</td>

                            <td>@m.TotalQty</td>

                        </tr>

                    }

                    @if (Model.Movements.Count == 0)

                    {

                        <tr>

                            <td colspan="5" style="color:rgba(255,255,255,.7);">No orders in this period.</td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

        </div>



    <div class="ts-shell-side ts-card" style="padding:14px;">

        <div style="margin-bottom:6px;">

            <div class="ts-card__title" style="margin-bottom:0;">

                @(Model.Form.MovementId.HasValue ? "Edit order" : "Create order")

            </div>

        </div>



        <form method="post"

              asp-action="InventorySave"

              asp-controller="Portal"

              asp-route-from="@Model.From.ToString("yyyy-MM-dd")"

              asp-route-to="@Model.To.ToString("yyyy-MM-dd")"

              asp-route-q="@Model.Q"

              asp-route-section="@Model.Section">

            <input type="hidden" asp-for="Form.MovementId" />



            <div class="row g-2">

                <div class="col-md-4">

                    <label class="ts-card__sub" style="display:block; margin-bottom:6px;">Order type</label>

                    <div class="form-control" style="background:rgba(255,255,255,.04); border-color:rgba(255,255,255,.12); color:rgba(255,255,255,.92);">

                        @(Model.Section == "purchase" ? "IN — Purchase" : "OUT — Sales")

                    </div>

                    <input type="hidden" asp-for="Form.MovementType" />

                </div>

                <div class="col-md-4">

                    <label class="ts-card__sub" style="display:block; margin-bottom:6px;">Created at</label>

                    <input class="form-control" asp-for="Form.CreatedAt" type="datetime-local" />

                </div>

                <div class="col-md-4">

                    <label class="ts-card__sub" style="display:block; margin-bottom:6px;">Affects stock</label>

                    <div class="form-check mt-2">

                        <input class="form-check-input" asp-for="Form.AffectsStock" type="checkbox" />

                    </div>

                </div>

                <div class="col-12">

                    <label class="ts-card__sub" style="display:block; margin-bottom:6px;">Note</label>

                    <input class="form-control" asp-for="Form.Note" />

                </div>

            </div>



            <div style="height:14px;"></div>



            <div style="max-height:420px; overflow:auto; border-radius:16px;">

                <table class="table table-dark table-sm align-middle mb-0">

                    <thead>

                        <tr>

                            <th>Product</th>

                            <th style="width:110px;">Qty</th>

                            <th style="width:140px;">Unit price</th>

                        </tr>

                    </thead>

                    <tbody>

                        @for (int i = 0; i < Model.Form.Lines.Count; i++)

                        {

                            <tr>

                                <td>

                                    <select class="form-select form-select-sm" asp-for="Form.Lines[i].ProductId">

                                        @foreach (var p in Model.Products)

                                        {

                                            <option value="@p.ProductId">@p.Name (@p.Barcode)</option>

                                        }

                                    </select>

                                </td>

                                <td>

                                    <input class="form-control form-control-sm" asp-for="Form.Lines[i].Quantity" type="number" step="1" min="0" />

                                </td>

                                <td>

                                    <input class="form-control form-control-sm" asp-for="Form.Lines[i].UnitPrice" type="number" step="0.01" min="0" />

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>



            <div style="height:14px;"></div>



            <button type="submit" class="btn btn-primary w-100">

                @(Model.Form.MovementId.HasValue ? "Update" : "Create")

            </button>

        </form>



        @if (Model.Form.MovementId.HasValue)

        {

            <form method="post"

                  asp-action="InventoryDelete"

                  asp-controller="Portal"

                  asp-route-from="@Model.From.ToString("yyyy-MM-dd")"

                  asp-route-to="@Model.To.ToString("yyyy-MM-dd")"

                  asp-route-q="@Model.Q"

                  asp-route-section="@Model.Section"

                  style="margin-top:12px;"

                  onsubmit="return confirm('Delete this movement?');">

                <input type="hidden" name="movementId" value="@Model.Form.MovementId.Value" />

                <button type="submit" class="btn btn-outline-danger w-100">Delete</button>

            </form>

        }



        @if (!string.IsNullOrWhiteSpace(Model.Error))

        {

            <div class="alert alert-danger mt-3">@Model.Error</div>

        }

    </div>

    </div>

</div>



