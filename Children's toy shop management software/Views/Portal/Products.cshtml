@model Children_s_toy_shop_management_software.Models.Products.ProductsPageVm

<div class="ts-shell-page">
    <div class="ts-shell-toolbar">
        <form method="get" asp-action="Products" asp-controller="Portal">
            <div class="ts-shell-toolbar__row">

                <div style="flex:1; min-width:240px;">
                    <label class="ts-card__sub">Search</label>
                    <input class="form-control" name="search" value="@Model.Search" placeholder="Name or barcode" />
                </div>

                <div style="min-width:190px;">
                    <label class="ts-card__sub">Category</label>
                    <select class="form-select" name="categoryId">
                        <option value="">All</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                        }
                    </select>
                </div>

                <div style="min-width:190px;">
                    <label class="ts-card__sub">Age</label>
                    <select class="form-select" name="ageRange">
                        <option value="">All</option>
                        @foreach (var a in Model.AgeRanges)
                        {
                            <option value="@a" selected="@(Model.AgeRange == a)">@a</option>
                        }
                    </select>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary">Filter</button>
                    <a class="btn btn-outline-light" asp-action="Products" asp-controller="Portal">Reset</a>
                </div>
            </div>
        </form>
    </div>

    <div class="ts-shell-layout">

        <!-- ================= TABLE ================= -->
        <div class="ts-shell-main ts-card" style="padding:14px;">

            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="alert alert-danger mb-3">@Model.Error</div>
            }

            <div class="ts-table-scroll">
                <table class="table table-dark table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width:70px;">ID</th>
                            <th style="width:90px;">Image</th> <!-- thêm -->
                            <th>Name</th>
                            <th style="width:150px;">Category</th>
                            <th style="width:120px;">Age</th>
                            <th style="width:120px;">Price</th>
                            <th style="width:90px;">Stock</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var p in Model.Products)
                        {
                            var isSelected = Model.SelectedProduct?.Id == p.Id;

                            <tr class="@(isSelected ? "table-primary" : "")">
                                <td>
                                    <a asp-action="Products"
                                           asp-controller="Portal"
                                           asp-route-id="@p.Id"
                                           asp-route-search="@Model.Search"
                                           asp-route-categoryId="@Model.CategoryId"
                                           asp-route-ageRange="@Model.AgeRange"
                                           class="text-decoration-none text-light">
                                        @p.Id
                                    </a>
                                </td>

                                <!-- IMAGE -->
                                <td>
                                    @if (!string.IsNullOrEmpty(p.ImagePath))
                                    {
                                        <img src="@Url.Content(p.ImagePath)"
                                             style="width:60px; height:60px; object-fit:cover; border-radius:8px;" />
                                    }
                                    else
                                    {
                                        <span style="color:gray;">No img</span>
                                    }
                                </td>

                                <td>@p.Name</td>
                                <td>@p.CategoryName</td>
                                <td>@p.AgeRange</td>
                                <td>@p.SellPrice.ToString("N0") ₫</td>
                                <td>@p.Quantity</td>
                            </tr>
                        }

                        @if (Model.Products.Count == 0)
                        {
                            <tr>
                                <td colspan="7">No products found.</td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>

        <!-- ================= FORM ================= -->
        <div class="ts-shell-side ts-card" style="padding:14px;">

            <div class="ts-card__title">
                @(Model.Form.ProductId.HasValue ? "Edit product" : "Create product")
            </div>

            <form method="post"
                  asp-action="ProductsSave"
                  asp-controller="Portal"
                  enctype="multipart/form-data">

                <input type="hidden" asp-for="Form.ProductId" />
                <input type="hidden" asp-for="Form.ExistingImagePath" />

                <div class="row g-2">

                    <div class="col-md-6">
                        <label class="ts-card__sub">Barcode</label>
                        <input class="form-control" asp-for="Form.Barcode" />
                    </div>

                    <div class="col-md-6">
                        <label class="ts-card__sub">Name</label>
                        <input class="form-control" asp-for="Form.Name" />
                    </div>

                    <div class="col-md-6">
                        <label class="ts-card__sub">Category</label>
                        <input class="form-control" asp-for="Form.CategoryName" />
                    </div>

                    <div class="col-md-6">
                        <label class="ts-card__sub">Age</label>
                        <input class="form-control" asp-for="Form.AgeRange" />
                    </div>

                    <div class="col-md-6">
                        <label class="ts-card__sub">Import price</label>
                        <input class="form-control" asp-for="Form.ImportPrice" type="number" />
                    </div>

                    <div class="col-md-6">
                        <label class="ts-card__sub">Sell price</label>
                        <input class="form-control" asp-for="Form.SellPrice" type="number" />
                    </div>

                    <!-- IMAGE UPLOAD -->
                    <div class="col-12">
                        <label class="ts-card__sub">Image</label>
                        <input class="form-control" asp-for="Form.ImageFile" type="file" accept="image/*" />

                        @if (!string.IsNullOrWhiteSpace(Model.Form.ExistingImagePath))
                        {
                            <div style="margin-top:10px;">
                                <img src="@Url.Content(Model.Form.ExistingImagePath)"
                                     style="width:140px; height:90px; object-fit:cover; border-radius:10px;" />
                            </div>
                        }
                    </div>

                </div>

                <div style="margin-top:10px;">
                    <button type="submit" class="btn btn-primary">
                        @(Model.Form.ProductId.HasValue ? "Update" : "Create")
                    </button>
                </div>

            </form>

        </div>

    </div>
</div>