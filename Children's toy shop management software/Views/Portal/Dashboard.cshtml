@model Children_s_toy_shop_management_software.Models.Dashboard.DashboardPageVm

@section Styles {
    <link rel="stylesheet" href="~/css/tabs/Dashboard/dashboard.css" asp-append-version="true" />
}
@{
    var activeMetric = (Model.ActiveMetric ?? "sales").Trim().ToLowerInvariant();
    var activeDetail = (Model.ActiveDetailBy ?? "week").Trim().ToLowerInvariant();
}

<div class="ts-shell-page" id="tsDashboardRoot">
    <div id="tsDashboardHeaderBlock" style="margin-bottom:14px;">
        <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:12px; margin-bottom:10px;">
            <div>
                <div class="ts-card__title" style="font-size:22px; margin-bottom:4px;">Advanced Dashboard</div>
                <div class="ts-card__sub">Track revenue, profit, orders and products sold</div>
            </div>
        </div>
    </div>

    <div class="ts-shell-toolbar" style="padding:16px 18px;">
        <div class="ts-kpis" style="margin-top:0; grid-template-columns: repeat(4, minmax(0, 1fr));">
            <div class="ts-kpi">
                <div class="ts-kpi__label">Revenue today</div>
                <div id="dashKpiRevenueToday" class="ts-kpi__value">@Model.RevenueToday.ToString("N0") ₫</div>
                <div class="ts-kpi__trend">Real-time</div>
            </div>

            <div class="ts-kpi">
                <div class="ts-kpi__label">Orders today</div>
                <div id="dashKpiOrdersToday" class="ts-kpi__value">@Model.OrdersToday</div>
                <div class="ts-kpi__trend">New orders</div>
            </div>

            <div class="ts-kpi">
                <div class="ts-kpi__label">Profit today</div>
                <div id="dashKpiProfitToday" class="ts-kpi__value">@Model.IncomeToday.ToString("N0") ₫</div>
                <div class="ts-kpi__trend">Revenue * 0.8</div>
            </div>

            <div class="ts-kpi">
                <div class="ts-kpi__label">Returns today</div>
                <div id="dashKpiReturnsToday" class="ts-kpi__value">@Model.ReturnedToday</div>
                <div class="ts-kpi__trend">Real-time</div>
            </div>

            <div class="ts-kpi" style="display:none;">
                <div class="ts-kpi__label">Low stock alerts</div>
                <div id="dashKpiLowStockCount" class="ts-kpi__value">@Model.LowStockCount</div>
                <div class="ts-kpi__trend">Products running low</div>
            </div>

            <div class="ts-kpi" style="display:none;">
                <div class="ts-kpi__label">Customers</div>
                <div id="dashKpiCustomersCount" class="ts-kpi__value">@Model.CustomersCount</div>
                <div class="ts-kpi__trend">Daily</div>
            </div>
        </div>
    </div>

    <div class="ts-shell-layout">
        <div class="ts-shell-main ts-card" style="padding:14px;">
            <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin-bottom:10px;">
                <div>
                    <div id="dashWeekTitle" class="ts-card__title" style="margin-bottom:2px;">Revenue vs last 6 days</div>
                    <div id="dashWeekSubtitle" class="ts-card__sub">Today compared to the previous days in this week</div>
                </div>
                <div style="text-align:right;">
                    <div class="ts-card__sub" style="margin-bottom:4px;">Change</div>
                    <div id="dashWeekChangeBadge" style="font-weight:900; font-size:14px; color:rgba(167,139,250,.95);">—</div>
                </div>
            </div>

            <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:10px;">
                <button type="button" class="dash-metric-tab @(activeMetric == "sales" ? "dash-metric-tab--active" : "")" data-dash-metric="sales">Sales</button>
                <button type="button" class="dash-metric-tab @(activeMetric == "orders" ? "dash-metric-tab--active" : "")" data-dash-metric="orders">Orders</button>
                <button type="button" class="dash-metric-tab @(activeMetric == "profit" ? "dash-metric-tab--active" : "")" data-dash-metric="profit">Profit</button>
                <button type="button" class="dash-metric-tab @(activeMetric == "productssold" ? "dash-metric-tab--active" : "")" data-dash-metric="productsSold">Products Sold</button>
            </div>

            <div style="display:flex; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:10px;">
                <div class="ts-card__sub" style="margin:0; font-weight:900;">Detail by:</div>
                <button type="button" class="dash-metric-tab @(activeDetail == "week" ? "dash-metric-tab--active" : "")" data-dash-detail="week">Week</button>
                <button type="button" class="dash-metric-tab @(activeDetail == "month" ? "dash-metric-tab--active" : "")" data-dash-detail="month">Month</button>
                <button type="button" class="dash-metric-tab @(activeDetail == "quarter" ? "dash-metric-tab--active" : "")" data-dash-detail="quarter">Quarter</button>
                <button type="button" class="dash-metric-tab @(activeDetail == "year" ? "dash-metric-tab--active" : "")" data-dash-detail="year">Year</button>
            </div>

            <div class="ts-chart-wrap" style="border-radius:16px; border:1px solid rgba(255,255,255,.10); background:rgba(255,255,255,.02); padding:6px;">
                <canvas id="dashRevenueWeekLine" style="width:100%; height:min(420px, 56vh); min-height:340px; display:block;"></canvas>
            </div>

            <div style="height:10px;"></div>

            <div class="ts-card__title" style="margin-bottom:4px;">Detail data</div>
            <div id="dashWeekDetailsCaption" class="ts-card__sub" style="margin-bottom:8px; line-height:1.35; max-width:52ch;"></div>
            <div id="dashWeekTableScroll" class="ts-table-scroll dash-week-table-scroll">
                <table id="dashWeekTable" class="table table-sm align-middle mb-0" style="width:100%;">
                    @* Header cells are built in JS from getWeekDetailColumnLabels() so they always match the selected metric tab. *@
                    <thead id="dashWeekTableHead"></thead>
                    <tbody id="dashWeekTableBody">
                        @* Rows + headers are built in JS so each metric tab can use its own column set (see mockup). *@
                        @if (Model.RevenueByDays == null || Model.RevenueByDays.Count == 0)
                        {
                            <tr><td colspan="6" style="opacity:.8;">No data</td></tr>
                        }
                        else
                        {
                            <tr><td colspan="6" style="opacity:.45;">&nbsp;</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="ts-shell-side ts-card dash-side-panel" style="padding:14px; display:block;">
            <div class="ts-card__title" style="margin-bottom:10px;">Revenue share — <span id="dashMonthMetricLabel">top products</span></div>

            <div class="ts-chart-wrap dash-donut-wrap" style="border-radius:16px; border:1px solid rgba(255,255,255,.10); background:rgba(255,255,255,.02); padding:10px;">
                <div class="dash-donut-square">
                    <canvas id="dashRevenueMonthBar" class="dash-donut-canvas"></canvas>
                </div>
            </div>
            <div style="height:10px;"></div>
            <div id="dashMonthChangeText" class="ts-card__sub" style="font-size:13px;">—</div>

            <div style="height:14px;"></div>
            <div class="ts-card__title" style="margin-bottom:8px;">Top 10 best-selling products</div>
            <div class="ts-table-scroll dash-top-products-scroll" style="max-height:min(520px, 52vh);">
                <table class="table table-dark table-sm align-middle mb-0 dash-top-products-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product name</th>
                            <th>Qty sold</th>
                            <th>Revenue</th>
                            <th>Share %</th>
                            <th>MoM %</th>
                        </tr>
                    </thead>
                    <tbody id="dashTopProductsBody">
                        @if (Model.TopProducts != null && Model.TopProducts.Count > 0)
                        {
                            decimal sumTopRev = 0m;
                            foreach (var t in Model.TopProducts) { sumTopRev += t.Revenue; }
                            foreach (var p in Model.TopProducts)
                            {
                                var sharePct = sumTopRev > 0 ? (p.Revenue / sumTopRev * 100m) : 0m;
                                var pct = p.RevenueChangePercent;
                                var arrow = pct > 0 ? "▲" : (pct < 0 ? "▼" : "—");
                                var color = pct > 0 ? "rgba(52,211,153,.95)" : (pct < 0 ? "rgba(239,68,68,.95)" : "rgba(255,255,255,.65)");
                                <tr>
                                    <td>@p.Rank</td>
                                    <td title="@p.Name" class="dash-top-product-name">@p.Name</td>
                                    <td>@p.QuantitySold</td>
                                    <td>@p.Revenue.ToString("N0") ₫</td>
                                    <td class="text-end">@sharePct.ToString("0.0")%</td>
                                    <td style="color:@color; font-weight:900; font-size:10px;" class="text-end">@arrow @Math.Abs(pct).ToString("0.0")%</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" style="opacity:.8;">No data</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const initialData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

            const els = {
                kpiRevenue: document.getElementById('dashKpiRevenueToday'),
                kpiOrders: document.getElementById('dashKpiOrdersToday'),
                kpiProfit: document.getElementById('dashKpiProfitToday'),
                kpiReturns: document.getElementById('dashKpiReturnsToday'),
                kpiLow: document.getElementById('dashKpiLowStockCount'),
                kpiCustomers: document.getElementById('dashKpiCustomersCount'),
                weekTitle: document.getElementById('dashWeekTitle'),
                weekSubtitle: document.getElementById('dashWeekSubtitle'),
                weekBadge: document.getElementById('dashWeekChangeBadge'),
                weekBody: document.getElementById('dashWeekTableBody'),
                weekTableHead: document.getElementById('dashWeekTableHead'),
                weekDetailsCaption: document.getElementById('dashWeekDetailsCaption'),
                monthCanvas: document.getElementById('dashRevenueMonthBar'),
                monthText: document.getElementById('dashMonthChangeText'),
                monthMetricLabel: document.getElementById('dashMonthMetricLabel'),
                monthLineCanvas: document.getElementById('dashRevenueWeekLine'),
                topBody: document.getElementById('dashTopProductsBody')
            };

           
            let leftChartTooltipEl = null;
            function ensureLeftChartTooltip() {
                if (leftChartTooltipEl) return leftChartTooltipEl;
                leftChartTooltipEl = document.createElement('div');
                leftChartTooltipEl.id = 'dashLeftChartHoverTooltip';
                leftChartTooltipEl.style.position = 'fixed';
                leftChartTooltipEl.style.zIndex = '9999';
                leftChartTooltipEl.style.pointerEvents = 'none';
                leftChartTooltipEl.style.padding = '6px 9px';
                leftChartTooltipEl.style.borderRadius = '10px';
                leftChartTooltipEl.style.background = 'rgba(14,14,16,.92)';
                leftChartTooltipEl.style.border = '1px solid rgba(255,255,255,.12)';
                leftChartTooltipEl.style.boxShadow = '0 18px 44px rgba(0,0,0,.35)';
                leftChartTooltipEl.style.color = 'rgba(255,255,255,.95)';
                leftChartTooltipEl.style.fontWeight = '900';
                leftChartTooltipEl.style.fontSize = '11px';
                leftChartTooltipEl.style.letterSpacing = '.05px';
                leftChartTooltipEl.style.display = 'none';
                document.body.appendChild(leftChartTooltipEl);
                return leftChartTooltipEl;
            }

            if (els.monthLineCanvas) {
                els.monthLineCanvas.addEventListener('mousemove', function (evt) {
                    const canvas = els.monthLineCanvas;
                    const pts = canvas.__dashLinePoints;
                    if (!pts || !pts.length) {
                        if (leftChartTooltipEl) leftChartTooltipEl.style.display = 'none';
                        return;
                    }

                    const rect = canvas.getBoundingClientRect();
                    const mx = evt.clientX - rect.left;
                    const my = evt.clientY - rect.top;

                    let bestIdx = -1;
                    let bestDist = 1e9;
                    for (let i = 0; i < pts.length; i++) {
                        const dx = mx - pts[i].x;
                        const dy = my - pts[i].y;
                        const d = Math.sqrt(dx * dx + dy * dy);
                        if (d < bestDist) {
                            bestDist = d;
                            bestIdx = i;
                        }
                    }

                    if (bestIdx >= 0 && bestDist <= 16) {
                        const isMoney = canvas.__dashLineIsMoney;
                        const v = pts[bestIdx].value ?? 0;
                        const label = String(pts[bestIdx].label ?? '');
                        const formatted = isMoney ? fmtVnd(v) : String(Number(v || 0));

                        const el = ensureLeftChartTooltip();
                        el.textContent = label + ': ' + formatted;
                        el.style.left = (evt.clientX + 12) + 'px';
                        el.style.top = (evt.clientY - 12) + 'px';
                        el.style.display = 'block';
                    } else {
                        if (leftChartTooltipEl) leftChartTooltipEl.style.display = 'none';
                    }
                });

                els.monthLineCanvas.addEventListener('mouseleave', function () {
                    if (leftChartTooltipEl) leftChartTooltipEl.style.display = 'none';
                });
            }

            let monthTooltipEl = null;
            function ensureMonthTooltip() {
                if (monthTooltipEl) return monthTooltipEl;
                monthTooltipEl = document.createElement('div');
                monthTooltipEl.id = 'dashMonthHoverTooltip';
                monthTooltipEl.style.position = 'fixed';
                monthTooltipEl.style.zIndex = '9999';
                monthTooltipEl.style.pointerEvents = 'none';
                monthTooltipEl.style.padding = '8px 10px';
                monthTooltipEl.style.borderRadius = '10px';
                monthTooltipEl.style.background = 'rgba(14,14,16,.92)';
                monthTooltipEl.style.border = '1px solid rgba(255,255,255,.12)';
                monthTooltipEl.style.boxShadow = '0 18px 44px rgba(0,0,0,.35)';
                monthTooltipEl.style.color = 'rgba(255,255,255,.95)';
                monthTooltipEl.style.fontWeight = '900';
                monthTooltipEl.style.fontSize = '12px';
                monthTooltipEl.style.letterSpacing = '.1px';
                monthTooltipEl.style.whiteSpace = 'pre-line';
                monthTooltipEl.style.display = 'none';
                document.body.appendChild(monthTooltipEl);
                return monthTooltipEl;
            }

            if (els.monthCanvas) {
                els.monthCanvas.addEventListener('mousemove', function (evt) {
                    const canvas = els.monthCanvas;
                    const slices = canvas.__dashPieSlices;
                    const geom = canvas.__dashDonutGeom;
                    const rect = canvas.getBoundingClientRect();
                    const mx = evt.clientX - rect.left;
                    const my = evt.clientY - rect.top;
                    if (!slices || !slices.length || !geom) {
                        if (monthTooltipEl) monthTooltipEl.style.display = 'none';
                        return;
                    }
                    const dCenter = Math.hypot(mx - geom.cx, my - geom.cy);
                    const rMax = geom.rOuterBase + geom.popPx + 4;
                    if (dCenter < geom.rInner - 2 || dCenter > rMax) {
                        if (canvas.__dashDonutHoverIdx !== -1) {
                            canvas.__dashDonutHoverIdx = -1;
                            drawTopProductsDonutChart(canvas, canvas.__dashDonutLastProducts, -1);
                        }
                        if (monthTooltipEl) monthTooltipEl.style.display = 'none';
                        return;
                    }
                    const t = angleFromTopClockwise(mx, my, geom.cx, geom.cy);
                    let idx = -1;
                    for (let i = 0; i < slices.length; i++) {
                        const sl = slices[i];
                        if (t >= sl.ang0 && (i < slices.length - 1 ? t < sl.ang1 : t <= sl.ang1 + 0.002)) {
                            idx = i;
                            break;
                        }
                    }
                    if (idx >= 0) {
                        if (canvas.__dashDonutHoverIdx !== idx) {
                            canvas.__dashDonutHoverIdx = idx;
                            drawTopProductsDonutChart(canvas, canvas.__dashDonutLastProducts, idx);
                        }
                        const sl = slices[idx];
                        const el = ensureMonthTooltip();
                        const shortName = sl.label.length > 40 ? sl.label.slice(0, 38) + '…' : sl.label;
                        el.textContent = shortName + '\n' + fmtVnd(sl.value);
                        el.style.left = (evt.clientX + 14) + 'px';
                        el.style.top = (evt.clientY - 14) + 'px';
                        el.style.display = 'block';
                    } else {
                        if (canvas.__dashDonutHoverIdx !== -1) {
                            canvas.__dashDonutHoverIdx = -1;
                            drawTopProductsDonutChart(canvas, canvas.__dashDonutLastProducts, -1);
                        }
                        if (monthTooltipEl) monthTooltipEl.style.display = 'none';
                    }
                });

                els.monthCanvas.addEventListener('mouseleave', function () {
                    const canvas = els.monthCanvas;
                    if (canvas.__dashDonutHoverIdx !== -1) {
                        canvas.__dashDonutHoverIdx = -1;
                        drawTopProductsDonutChart(canvas, canvas.__dashDonutLastProducts, -1);
                    }
                    if (monthTooltipEl) monthTooltipEl.style.display = 'none';
                });
            }

            let latestData = initialData;
            let activeMetric = normalizeDashboardMetricKey('@activeMetric'); // sales | orders | profit | productsSold
            let activeDetail = '@activeDetail'; // week | month | quarter | year
            let dashAnimateBars = false;

            // MVC reload: lấy state từ querystring để đảm bảo mapping đúng tab.
            // (Tránh trường hợp ActiveMetric/ActiveDetailBy trong Model không khớp thực tế UI.)
            try {
                const urlParams = new URL(window.location.href).searchParams;
                const qMetric = urlParams.get('metric');
                const qDetailBy = urlParams.get('detailBy');
                if (qMetric) activeMetric = normalizeDashboardMetricKey(qMetric);
                if (qDetailBy) activeDetail = qDetailBy.toString().trim().toLowerCase();
            } catch {
                // ignore
            }

            const metricMeta = {
                sales: { label: 'Revenue', isMoney: true },
                orders: { label: 'Orders', isMoney: false },
                profit: { label: 'Profit', isMoney: true }, // computed from server's Income* fields (profit = revenue * 0.8)
                productsSold: { label: 'Products Sold', isMoney: false }
            };

            /** Aligns URL / data-dash-metric / click handlers with metricMeta keys (e.g. productssold → productsSold). */
            function normalizeDashboardMetricKey(metric) {
                let m = String(metric ?? 'sales').trim().toLowerCase();
                if (!m) return 'sales';
                if (m === 'products_sold' || m === 'products-sold' || m === 'productsold') m = 'productssold';
                if (m === 'productssold') return 'productsSold';
                return m;
            }

            function readNum(obj, pascalKey, camelKey) {
                if (!obj) return 0;
                const v = obj[pascalKey] ?? obj[camelKey];
                const n = Number(v || 0);
                return Number.isFinite(n) ? n : 0;
            }

            function readStr(obj, pascalKey, camelKey) {
                if (!obj) return '';
                const v = obj[pascalKey] ?? obj[camelKey];
                return v == null ? '' : String(v);
            }

            function escapeHtml(s) {
                return String(s || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/"/g, '&quot;');
            }

            function truncateText(s, maxLen) {
                const t = String(s || '');
                if (t.length <= maxLen) return t;
                return t.slice(0, Math.max(0, maxLen - 1)) + '…';
            }

            /** Column count per metric (matches mockup layouts). */
            function getWeekDetailColumnCount(metric) {
                const m = normalizeDashboardMetricKey(metric);
                if (m === 'orders' || m === 'profit') return 6;
                return 5;
            }

            /** Detail table headers: each tab uses its own column set (not just reorder). */
            function getWeekDetailColumnLabels(metric, leftHeader) {
                const m = normalizeDashboardMetricKey(metric);
                const M = metricMeta[m] || metricMeta.sales;
                if (m === 'orders') {
                    return [leftHeader, M.label, 'Growth %', 'Completed', 'Pending', 'Cancelled'];
                }
                if (m === 'profit') {
                    return [leftHeader, M.label, 'Profit margin %', 'Revenue', 'Cost', 'Growth %'];
                }
                if (m === 'productsSold') {
                    return [leftHeader, 'Total products sold', 'Avg per order', 'Top product', 'Growth %'];
                }
                return [leftHeader, M.label, 'Avg order value', 'Discount used', 'Growth %'];
            }

            function buildWeekDetailRow(metric, dayLabel, row, growthPct) {
                const m = normalizeDashboardMetricKey(metric);
                const g = Number(growthPct || 0) || 0;
                const color = g > 0 ? 'rgba(52,211,153,.95)' : (g < 0 ? 'rgba(239,68,68,.95)' : 'rgba(255,255,255,.65)');
                const sign = g > 0 ? '+' : (g < 0 ? '-' : '');
                const gr = sign + Math.abs(g).toFixed(1) + '%';

                const ordersVal = readNum(row, 'OrdersCount', 'ordersCount');
                const revenueVal = readNum(row, 'Revenue', 'revenue');
                const profitVal = readNum(row, 'Income', 'income');
                const soldVal = readNum(row, 'ProductsSold', 'productsSold');
                const completed = readNum(row, 'OrdersCompleted', 'ordersCompleted');
                const pending = readNum(row, 'OrdersPending', 'ordersPending');
                const cancelled = readNum(row, 'OrdersCancelled', 'ordersCancelled');
                const discountVal = readNum(row, 'DiscountAmount', 'discountAmount');
                const topName = readStr(row, 'TopProductName', 'topProductName');
                const avgOrderVal = ordersVal > 0 ? revenueVal / ordersVal : 0;
                const avgPerOrderSold = ordersVal > 0 ? soldVal / ordersVal : 0;
                const profitMarginPct = revenueVal > 0 ? (profitVal / revenueVal) * 100 : 0;
                const costVal = revenueVal - profitVal;

                function tdCell(innerStyle, innerHtml) {
                    return '<td style="' + innerStyle + '">' + innerHtml + '</td>';
                }
                const sBase = 'background-color: transparent !important;';
                const sR = sBase + ' text-align:right;';
                const sRg = sR + ' color:' + color + ' !important;';
                const sRleft = sBase + ' text-align:left; max-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;';
                const trOpen = '<tr style="background-color: transparent !important;">';

                if (m === 'orders') {
                    return trOpen +
                        tdCell(sBase, dayLabel) +
                        tdCell(sR, String(Math.round(ordersVal))) +
                        tdCell(sRg, gr) +
                        tdCell(sR, String(Math.round(completed))) +
                        tdCell(sR, String(Math.round(pending))) +
                        tdCell(sR, String(Math.round(cancelled))) +
                        '</tr>';
                }
                if (m === 'profit') {
                    return trOpen +
                        tdCell(sBase, dayLabel) +
                        tdCell(sR, fmtVnd(profitVal)) +
                        tdCell(sR, profitMarginPct.toFixed(1) + '%') +
                        tdCell(sR, fmtVnd(revenueVal)) +
                        tdCell(sR, fmtVnd(costVal)) +
                        tdCell(sRg, gr) +
                        '</tr>';
                }
                if (m === 'productsSold') {
                    return trOpen +
                        tdCell(sBase, dayLabel) +
                        tdCell(sR, String(Math.round(soldVal))) +
                        tdCell(sR, avgPerOrderSold.toFixed(2)) +
                        tdCell(sRleft, escapeHtml(truncateText(topName, 42))) +
                        tdCell(sRg, gr) +
                        '</tr>';
                }
                return trOpen +
                    tdCell(sBase, dayLabel) +
                    tdCell(sR, fmtVnd(revenueVal)) +
                    tdCell(sR, fmtVnd(avgOrderVal)) +
                    tdCell(sR, fmtVnd(discountVal)) +
                    tdCell(sRg, gr) +
                    '</tr>';
            }

            /** Shared thead markup so tab clicks and full render stay in sync. */
            function buildWeekTableHeadHtml(metric, leftHeader) {
                const cols = getWeekDetailColumnLabels(metric, leftHeader);
                const m = normalizeDashboardMetricKey(metric);
                return '<tr>' + cols.map(function (h, i) {
                    const align = i === 0 ? 'text-start' : (i === 3 && m === 'productsSold' ? 'text-start' : 'text-end');
                    return '<th class="' + align + '">' + h + '</th>';
                }).join('') + '</tr>';
            }

            // Không cần applyActive* cho MVC thuần vì Razor đã render class đúng trạng thái.

            function fmtVnd(n) {
                const v = Number(n || 0);
                // Keep consistent with VND display style
                return new Intl.NumberFormat('vi-VN').format(v) + ' ₫';
            }

            function calcPct(curr, prev) {
                const c = Number(curr || 0);
                const p = Number(prev || 0);
                if (p === 0) return c === 0 ? 0 : 100;
                return ((c - p) / p) * 100;
            }

            /** Round axis max to a readable step (1–2–5 × 10^n). */
            function niceYMax(raw) {
                const max = Math.max(Number(raw) || 0, 0);
                if (max <= 0) return 1;
                const exp = Math.floor(Math.log10(max));
                const pow10 = Math.pow(10, exp);
                const n = max / pow10;
                const ceil = n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10;
                return ceil * pow10;
            }

            /** Compact tick labels for Y axis (similar to reference: 0, 2.0k, 10k …). */
            function formatAxisTick(v, isMoney) {
                const x = Number(v || 0);
                if (isMoney) {
                    if (x === 0) return '0';
                    if (Math.abs(x) >= 1e9) return (x / 1e9).toFixed(1) + 'B';
                    if (Math.abs(x) >= 1e6) return (x / 1e6).toFixed(1) + 'M';
                    if (Math.abs(x) >= 1e3) return (x / 1e3).toFixed(1) + 'k';
                    return String(Math.round(x));
                }
                if (x === 0) return '0';
                if (Math.abs(x) >= 1e6) return (x / 1e6).toFixed(1) + 'M';
                if (Math.abs(x) >= 1e3) return (x / 1e3).toFixed(1) + 'k';
                if (Math.abs(x - Math.round(x)) < 1e-6) return String(Math.round(x));
                return x.toFixed(1);
            }

            function formatBarTopValue(v, isMoney) {
                const x = Number(v || 0);
                if (isMoney) {
                    if (Math.abs(x) >= 1e9) return (x / 1e9).toFixed(1) + 'B';
                    if (Math.abs(x) >= 1e6) return (x / 1e6).toFixed(2) + 'M';
                    if (Math.abs(x) >= 1e3) return (x / 1e3).toFixed(1) + 'k';
                    return new Intl.NumberFormat('en-US').format(Math.round(x));
                }
                return new Intl.NumberFormat('en-US').format(Math.round(x));
            }

            function setupCanvas(canvas) {
                if (!canvas) return null;
                const ctx = canvas.getContext('2d');
                const dpr = window.devicePixelRatio || 1;
                const rect = canvas.getBoundingClientRect();
                const w = Math.max(1, Math.round(rect.width));
                const h = Math.max(1, Math.round(rect.height));
                canvas.width = Math.round(w * dpr);
                canvas.height = Math.round(h * dpr);
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                return { ctx, w, h };
            }

            function drawLineChart(canvas, labels, values, options) {
                const opts = options || {};
                const isMoney = !!opts.isMoney;
                const storePoints = !!opts.storePoints;
                const s = setupCanvas(canvas);
                if (!s) return;
                const { ctx, w, h } = s;
                ctx.clearRect(0, 0, w, h);

                const rawMax = Math.max(...values.map(v => Number(v || 0)), 0.0001);
                const yScaleMax = niceYMax(rawMax);
                const pad = { left: 46, right: 12, top: 12, bottom: 30 };
                const innerW = w - pad.left - pad.right;
                const innerH = h - pad.top - pad.bottom;
                const plotBottom = pad.top + innerH;

                const n = values.length;
                if (n < 2) return;

                function xAt(i) { return pad.left + innerW * (i / (n - 1)); }
                function yAt(v) {
                    const vv = Number(v || 0);
                    const t = vv / yScaleMax;
                    return pad.top + innerH * (1 - t);
                }

                // Axes only (no inner grid — matches reference)
                ctx.strokeStyle = 'rgba(255,255,255,.22)';
                ctx.lineWidth = 1;
                ctx.beginPath();
                ctx.moveTo(pad.left, pad.top);
                ctx.lineTo(pad.left, plotBottom);
                ctx.lineTo(pad.left + innerW, plotBottom);
                ctx.stroke();

                const yTickSteps = 8;
                ctx.fillStyle = 'rgba(255,255,255,.72)';
                ctx.font = '11px system-ui, Segoe UI, sans-serif';
                ctx.textAlign = 'right';
                ctx.textBaseline = 'middle';
                for (let i = 0; i <= yTickSteps; i++) {
                    const tickVal = yScaleMax * i / yTickSteps;
                    const yy = yAt(tickVal);
                    ctx.fillText(formatAxisTick(tickVal, isMoney), pad.left - 6, yy);
                }

                // Area under line (subtle)
                ctx.fillStyle = 'rgba(167,139,250,.10)';
                ctx.beginPath();
                ctx.moveTo(xAt(0), yAt(values[0]));
                for (let i = 1; i < n; i++) ctx.lineTo(xAt(i), yAt(values[i]));
                ctx.lineTo(xAt(n - 1), pad.top + innerH);
                ctx.lineTo(xAt(0), pad.top + innerH);
                ctx.closePath();
                ctx.fill();

                // Line
                ctx.strokeStyle = 'rgba(167,139,250,.95)';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.moveTo(xAt(0), yAt(values[0]));
                for (let i = 1; i < n; i++) ctx.lineTo(xAt(i), yAt(values[i]));
                ctx.stroke();

                // Points (also store for hover tooltip if requested)
                const points = [];
                for (let i = 0; i < n; i++) {
                    const x = xAt(i), y = yAt(values[i]);
                    if (storePoints) {
                        points.push({
                            x,
                            y,
                            label: labels[i] ?? '',
                            value: values[i] ?? 0
                        });
                    }
                    ctx.fillStyle = 'rgba(167,139,250,.95)';
                    ctx.beginPath();
                    ctx.arc(x, y, 3.3, 0, Math.PI * 2);
                    ctx.fill();
                }

                // X axis labels (categories)
                const step = n <= 10 ? 1 : Math.ceil(n / 8);
                ctx.fillStyle = 'rgba(255,255,255,.78)';
                ctx.font = '11px system-ui, Segoe UI, sans-serif';
                ctx.textBaseline = 'top';
                for (let i = 0; i < n; i += step) {
                    const x = xAt(i);
                    const text = String(labels[i] ?? '');
                    const isFirst = i === 0;
                    const isLast = i === n - 1;
                    if (isFirst) {
                        ctx.textAlign = 'left';
                        ctx.fillText(text, x, plotBottom + 6);
                    } else if (isLast) {
                        ctx.textAlign = 'right';
                        ctx.fillText(text, x, plotBottom + 6);
                    } else {
                        ctx.textAlign = 'center';
                        ctx.fillText(text, x, plotBottom + 6);
                    }
                }

                if (storePoints) {
                    canvas.__dashLinePoints = points;
                    canvas.__dashLineIsMoney = isMoney;
                } else {
                    canvas.__dashLinePoints = null;
                }
            }

            function drawBarChart(canvas, labels, values, colors, options) {
                const opts = options || {};
                const animate = !!opts.animate;
                const duration = Number(opts.duration || 650);
                const fromValue = Number(opts.fromValue || 0);
                const isMoney = !!opts.isMoney;

                const s = setupCanvas(canvas);
                if (!s) return;
                const { ctx, w, h } = s;
                const pad = { left: 46, right: 14, top: 12, bottom: 32 };
                const innerW = w - pad.left - pad.right;
                const innerH = h - pad.top - pad.bottom;
                const plotBottom = pad.top + innerH;

                const n = values.length;
                if (n < 1) return;

                const maxTarget = Math.max(...values.map(v => Number(v || 0)), 0.0001);
                const yScaleMax = niceYMax(maxTarget);

                function yAtValue(vv) {
                    const t = Number(vv || 0) / yScaleMax;
                    return pad.top + innerH * (1 - t);
                }

                function renderFrame(progress) {
                    ctx.clearRect(0, 0, w, h);

                    // Y axis + X axis (no inner grid)
                    ctx.strokeStyle = 'rgba(255,255,255,.22)';
                    ctx.lineWidth = 1;
                    ctx.beginPath();
                    ctx.moveTo(pad.left, pad.top);
                    ctx.lineTo(pad.left, plotBottom);
                    ctx.lineTo(pad.left + innerW, plotBottom);
                    ctx.stroke();

                    const yTickSteps = 8;
                    ctx.fillStyle = 'rgba(255,255,255,.72)';
                    ctx.font = '11px system-ui, Segoe UI, sans-serif';
                    ctx.textAlign = 'right';
                    ctx.textBaseline = 'middle';
                    for (let ti = 0; ti <= yTickSteps; ti++) {
                        const tickVal = yScaleMax * ti / yTickSteps;
                        const yy = yAtValue(tickVal);
                        ctx.fillText(formatAxisTick(tickVal, isMoney), pad.left - 6, yy);
                    }

                    const gap = innerW * 0.09;
                    const barW = (innerW - gap * (n - 1)) / n;

                    const showValueLabels = !animate || progress >= 0.999;

                    for (let i = 0; i < n; i++) {
                        const target = Number(values[i] || 0);
                        const vv = fromValue + (target - fromValue) * progress;
                        const t = vv / yScaleMax;
                        const barH = innerH * t;
                        const x = pad.left + i * (barW + gap);
                        const y = pad.top + (innerH - barH);

                        const fill = colors && colors[i] ? colors[i] : 'rgba(167,139,250,.85)';
                        ctx.fillStyle = fill;
                        ctx.fillRect(x, y, barW, barH);

                        if (showValueLabels) {
                            ctx.fillStyle = 'rgba(255,255,255,.88)';
                            ctx.font = 'bold 11px system-ui, Segoe UI, sans-serif';
                            ctx.textAlign = 'center';
                            ctx.textBaseline = 'bottom';
                            const topTxt = formatBarTopValue(target, isMoney);
                            ctx.fillText(topTxt, x + barW / 2, Math.max(pad.top + 10, y - 4));
                        }

                        const labelText = String(labels[i] ?? '');
                        const xFont = n > 10 ? '10px' : '11px';
                        ctx.fillStyle = 'rgba(255,255,255,.78)';
                        ctx.font = xFont + ' system-ui, Segoe UI, sans-serif';
                        ctx.textBaseline = 'top';
                        ctx.textAlign = 'center';
                        ctx.fillText(labelText, x + barW / 2, plotBottom + 6);
                    }
                }

                if (!animate) {
                    renderFrame(1);
                    return;
                }

                // Cancel previous animation on the same canvas.
                if (canvas.__dashBarRaf) cancelAnimationFrame(canvas.__dashBarRaf);
                const token = (canvas.__dashBarAnimToken = (canvas.__dashBarAnimToken || 0) + 1);
                const start = performance.now();

                function easeOutCubic(t) {
                    return 1 - Math.pow(1 - t, 3);
                }

                function tick(now) {
                    if (token !== canvas.__dashBarAnimToken) return;
                    const elapsed = now - start;
                    const p = Math.min(1, elapsed / duration);
                    const e = easeOutCubic(p);
                    renderFrame(e);
                    if (p < 1) {
                        canvas.__dashBarRaf = requestAnimationFrame(tick);
                    } else {
                        renderFrame(1);
                    }
                }

                canvas.__dashBarRaf = requestAnimationFrame(tick);
            }

            /** Donut chart: outline = opaque RGB, fill = same hue with transparency. hoverIndex pops slice outward. */
            const dashDonutPalette = [
                [167, 139, 250], [52, 211, 153], [96, 165, 250], [251, 191, 36],
                [244, 114, 182], [45, 212, 191], [168, 85, 247], [248, 113, 113],
                [125, 211, 252], [192, 132, 252]
            ];

            function drawTopProductsDonutChart(canvas, topProducts, hoverIndex) {
                const s = setupCanvas(canvas);
                if (!s) return 0;
                const { ctx, w, h } = s;
                ctx.clearRect(0, 0, w, h);
                const list = Array.isArray(topProducts) ? topProducts.filter(function (p) { return p; }) : [];
                canvas.__dashDonutLastProducts = list;
                canvas.__dashDonutHoverIdx = (hoverIndex == null || hoverIndex < 0) ? -1 : hoverIndex;

                if (list.length === 0) {
                    canvas.__dashPieSlices = null;
                    canvas.__dashDonutGeom = null;
                    return 0;
                }
                const revs = list.map(function (p) { return readNum(p, 'Revenue', 'revenue'); });
                const total = revs.reduce(function (a, b) { return a + b; }, 0);
                if (total <= 0) {
                    canvas.__dashPieSlices = null;
                    canvas.__dashDonutGeom = null;
                    return 0;
                }

                const cx = w / 2;
                const cy = h / 2;
                const size = Math.min(w, h);
                const rOuterBase = size * 0.32;
                const rInner = rOuterBase * 0.58;
                const popPx = 14;
                const hoverIdx = canvas.__dashDonutHoverIdx;

                let cum = 0;
                const slices = [];
                for (let i = 0; i < list.length; i++) {
                    const frac = revs[i] / total;
                    const span = frac * 2 * Math.PI;
                    const start = -Math.PI / 2 + cum;
                    const end = start + span;
                    const isHover = hoverIdx === i;
                    const rOut = rOuterBase + (isHover ? popPx : 0);
                    const rgb = dashDonutPalette[i % dashDonutPalette.length];
                    const fillRgba = 'rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',0.38)';
                    const outlineRgb = 'rgb(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ')';

                    ctx.save();
                    if (isHover) {
                        ctx.shadowColor = 'rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',0.55)';
                        ctx.shadowBlur = 22;
                        ctx.shadowOffsetX = 0;
                        ctx.shadowOffsetY = 4;
                    }

                    ctx.beginPath();
                    ctx.arc(cx, cy, rOut, start, end);
                    ctx.arc(cx, cy, rInner, end, start, true);
                    ctx.closePath();
                    ctx.fillStyle = fillRgba;
                    ctx.fill();

                    ctx.shadowColor = 'transparent';
                    ctx.shadowBlur = 0;
                    ctx.shadowOffsetY = 0;

                    ctx.strokeStyle = outlineRgb;
                    ctx.lineWidth = isHover ? 3.2 : 2.2;
                    ctx.lineJoin = 'round';
                    ctx.stroke();

                    ctx.restore();

                    const name = String(list[i].Name ?? list[i].name ?? '');
                    const pct = frac * 100;
                    const mid = (start + end) / 2;
                    const rMid = (rOut + rInner) / 2;
                    const tx = cx + Math.cos(mid) * rMid;
                    const ty = cy + Math.sin(mid) * rMid;

                    if (span > 0.12) {
                        ctx.save();
                        ctx.font = (isHover ? 'bold ' : '') + '11px system-ui, Segoe UI, sans-serif';
                        ctx.fillStyle = 'rgba(255,255,255,.94)';
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'middle';
                        ctx.lineWidth = 3;
                        ctx.strokeStyle = 'rgba(8,12,28,.75)';
                        const label = pct < 10 ? pct.toFixed(1) + '%' : Math.round(pct) + '%';
                        ctx.strokeText(label, tx, ty);
                        ctx.fillText(label, tx, ty);
                        ctx.restore();
                    }

                    slices.push({
                        ang0: cum,
                        ang1: cum + span,
                        label: name,
                        value: revs[i],
                        pct: pct,
                        cx: cx,
                        cy: cy,
                        rOuter: rOut,
                        rInner: rInner,
                        rOuterBase: rOuterBase
                    });
                    cum += span;
                }

                canvas.__dashPieSlices = slices;
                canvas.__dashDonutGeom = { cx: cx, cy: cy, rInner: rInner, rOuterBase: rOuterBase, popPx: popPx };
                return total;
            }

            function angleFromTopClockwise(mx, my, cx, cy) {
                const dx = mx - cx;
                const dy = my - cy;
                const a = Math.atan2(dy, dx);
                let t = a + Math.PI / 2;
                if (t < 0) t += 2 * Math.PI;
                if (t >= 2 * Math.PI) t -= 2 * Math.PI;
                return t;
            }


            function renderForActiveMetric(data) {
                if (!data) return;

                const meta = metricMeta[normalizeDashboardMetricKey(activeMetric)] || metricMeta.sales;

                const daysRaw = data.RevenueByDays ?? data.revenueByDays;
                let days = Array.isArray(daysRaw) ? daysRaw : [];
                const detail = (activeDetail || '').toString().trim().toLowerCase(); // normalize

                // Compatibility layer:
                // Older versions grouped `detail=month` results into weeks on the client.
                // With the updated server logic, `detail=month` already returns monthly buckets,
                // so this aggregation should not trigger (month labels are like "Jan", "Feb"...).
                function startOfWeekMonday(d) {
                    const x = new Date(d);
                    x.setHours(0, 0, 0, 0);
                    const day = x.getDay(); // 0=Sun ... 6=Sat
                    const diff = (day + 6) % 7; // Monday start
                    x.setDate(x.getDate() - diff);
                    return x;
                }
                if (detail === 'month' && days.length > 0 && String(days[0].Label ?? '').match(/^\d{1,2}$/)) {
                    const weekMap = new Map(); // weekStartISO -> aggregates
                    for (const item of days) {
                        const dtRaw = item.Date ?? item.date ?? null;
                        const dt = dtRaw ? new Date(dtRaw) : null;
                        if (!dt || Number.isNaN(dt.getTime())) continue;

                        const ws = startOfWeekMonday(dt);
                        const key = ws.toISOString().slice(0, 10);

                        const current = weekMap.get(key) || {
                            Date: ws,
                            Label: '',
                            OrdersCount: 0,
                            Revenue: 0,
                            Income: 0,
                            ProductsSold: 0
                        };

                        current.OrdersCount += readNum(item, 'OrdersCount', 'ordersCount');
                        current.Revenue += readNum(item, 'Revenue', 'revenue');
                        current.Income += readNum(item, 'Income', 'income');
                        current.ProductsSold += readNum(item, 'ProductsSold', 'productsSold');

                        weekMap.set(key, current);
                    }

                    const sorted = Array.from(weekMap.values()).sort((a, b) => new Date(a.Date).getTime() - new Date(b.Date).getTime());
                    // relabel W1/W2... for x-axis/table
                    sorted.forEach((w, idx) => {
                        w.Label = `W${idx + 1}`;
                    });

                    days = sorted;
                }

                const labels = days.map(d => String(d.Label ?? d.label ?? ''));
                const ordersArr = days.map(d => readNum(d, 'OrdersCount', 'ordersCount'));
                const revenueArr = days.map(d => readNum(d, 'Revenue', 'revenue'));
                const profitArr = days.map(d => readNum(d, 'Income', 'income'));
                const soldArr = days.map(d => readNum(d, 'ProductsSold', 'productsSold'));

                const metricKey = normalizeDashboardMetricKey(activeMetric);
                let metricArr = revenueArr;
                if (metricKey === 'orders') metricArr = ordersArr;
                if (metricKey === 'profit') metricArr = profitArr;
                if (metricKey === 'productsSold') metricArr = soldArr;

                // Titles + labels
                if (els.weekTitle) {
                    const detailLabel =
                        detail === 'week' ? 'Last 7 days' :
                            detail === 'month' ? 'Months in this year' :
                                detail === 'quarter' ? 'Quarters in this year' :
                                    'Years (last 5)';
                    els.weekTitle.textContent = `${meta.label} (${detailLabel})`;
                }
                if (els.weekSubtitle) {
                    els.weekSubtitle.textContent =
                        detail === 'week' ? 'Daily breakdown (last 7 days)' :
                            detail === 'month' ? 'Monthly breakdown (12 months)' :
                                detail === 'quarter' ? 'Quarterly breakdown (4 quarters)' :
                                    'Yearly breakdown (last 5 years)';
                }

                // Table header + growth vs previous day.
                function fmtMaybeMoney(val) {
                    if (meta.isMoney) return fmtVnd(val);
                    return String(Number(val || 0));
                }

                const growthArr = metricArr.map(function (v, idx) {
                    if (idx === 0) return 0;
                    const prevVal = metricArr[idx - 1];
                    if (!prevVal || prevVal === 0) return 0;
                    return ((v - prevVal) / prevVal) * 100;
                });

                if (els.weekTableHead) {
                    const leftHeader = detail === 'week' ? 'Day' : 'Time period';
                    els.weekTableHead.innerHTML = buildWeekTableHeadHtml(activeMetric, leftHeader);
                }
                if (els.weekDetailsCaption) {
                    els.weekDetailsCaption.textContent =
                        'Columns change by tab. Growth % follows the chart series for this tab.';
                }
                if (els.monthMetricLabel) els.monthMetricLabel.textContent = 'top products';

                // Week badge: today vs avg(previous 6 days)
                if (metricArr.length >= 2) {
                    const todayVal = metricArr[metricArr.length - 1];
                    const prev = metricArr.slice(0, -1);
                    const prevAvg = prev.reduce((a, b) => a + b, 0) / Math.max(prev.length, 1);
                    const pct = calcPct(todayVal, prevAvg);
                    const dir = pct > 0 ? '▲' : (pct < 0 ? '▼' : '—');
                    if (els.weekBadge) els.weekBadge.textContent = `${dir} ${Math.abs(pct).toFixed(1)}%`;
                } else {
                    if (els.weekBadge) els.weekBadge.textContent = '—';
                }

                // Weekly table (columns depend on active metric)
                if (els.weekBody) {
                    if (days.length > 0) {
                        els.weekBody.innerHTML = days.map(function (d, i) {
                            const dayLabel = String(d.Label ?? d.label ?? '');
                            const g = Number(growthArr[i] ?? 0) || 0;
                            return buildWeekDetailRow(activeMetric, dayLabel, d, g);
                        }).join('');
                    } else {
                        const nCol = getWeekDetailColumnCount(activeMetric);
                        els.weekBody.innerHTML = '<tr style="background-color: transparent !important;"><td colspan="' + nCol + '" style="opacity:.8;">No data</td></tr>';
                    }
                }

                // Chart type changes with time detail (bar for week/month, line for quarter/year).
                const useLineChart = detail === 'month' || detail === 'quarter' || detail === 'year';
                if (useLineChart) {
                    drawLineChart(els.monthLineCanvas, labels, metricArr, {
                        isMoney: meta.isMoney,
                        storePoints: true
                    });
                } else {
                    const colors = meta.isMoney
                        ? ['rgba(167,139,250,.85)', 'rgba(167,139,250,.85)', 'rgba(167,139,250,.85)', 'rgba(167,139,250,.85)', 'rgba(167,139,250,.85)', 'rgba(167,139,250,.85)', 'rgba(167,139,250,.85)']
                        : ['rgba(167,139,250,.85)', 'rgba(167,139,250,.85)', 'rgba(167,139,250,.85)', 'rgba(167,139,250,.85)', 'rgba(167,139,250,.85)', 'rgba(167,139,250,.85)', 'rgba(167,139,250,.85)'];
                    drawBarChart(els.monthLineCanvas, labels, metricArr, colors, {
                        animate: dashAnimateBars,
                        duration: 700,
                        fromValue: 0,
                        isMoney: meta.isMoney
                    });
                    dashAnimateBars = false; // animate only once per trigger
                }

                const topPieRaw = data.TopProducts ?? data.topProducts;
                const topPie = Array.isArray(topPieRaw) ? topPieRaw : [];
                const pieSum = drawTopProductsDonutChart(els.monthCanvas, topPie, -1);
                if (els.monthText) {
                    els.monthText.textContent = pieSum > 0 ? ('Top 10 revenue: ' + fmtVnd(pieSum)) : '—';
                }
            }

            function applyDashboardData(data, animateBars) {
                if (!data) return;

                latestData = data;
                dashAnimateBars = !!animateBars;

                const revenueToday = readNum(data, 'RevenueToday', 'revenueToday');
                const ordersToday = readNum(data, 'OrdersToday', 'ordersToday');
                const returnsToday = readNum(data, 'ReturnedToday', 'returnedToday');
                const lowStock = readNum(data, 'LowStockCount', 'lowStockCount');
                const customers = readNum(data, 'CustomersCount', 'customersCount');
                const profitToday = readNum(data, 'IncomeToday', 'incomeToday'); // profit

                if (els.kpiRevenue) els.kpiRevenue.textContent = fmtVnd(revenueToday);
                if (els.kpiOrders) els.kpiOrders.textContent = ordersToday;
                if (els.kpiProfit) els.kpiProfit.textContent = fmtVnd(profitToday);
                if (els.kpiReturns) els.kpiReturns.textContent = returnsToday;
                if (els.kpiLow) els.kpiLow.textContent = lowStock;
                if (els.kpiCustomers) els.kpiCustomers.textContent = customers;

                // Render charts + tables
                renderForActiveMetric(data);

                // Top products table (always Sales-based list)
                const topRaw = data.TopProducts ?? data.topProducts;
                const top = Array.isArray(topRaw) ? topRaw : [];
                if (els.topBody) {
                    if (top.length > 0) {
                        let sumRev = 0;
                        for (let i = 0; i < top.length; i++) {
                            sumRev += readNum(top[i], 'Revenue', 'revenue');
                        }
                        els.topBody.innerHTML = top.map(function (p) {
                            const name = String(p.Name ?? p.name ?? '');
                            const qty = readNum(p, 'QuantitySold', 'quantitySold');
                            const rev = readNum(p, 'Revenue', 'revenue');
                            const sharePct = sumRev > 0 ? (rev / sumRev) * 100 : 0;
                            const pct = readNum(p, 'RevenueChangePercent', 'revenueChangePercent');
                            const arrow = pct > 0 ? '▲' : (pct < 0 ? '▼' : '—');
                            const color = pct > 0 ? 'rgba(52,211,153,.95)' : (pct < 0 ? 'rgba(239,68,68,.95)' : 'rgba(255,255,255,.65)');
                            return '<tr>' +
                                '<td>' + readNum(p, 'Rank', 'rank') + '</td>' +
                                '<td class="dash-top-product-name" title="' + name.replace(/"/g, '&quot;') + '">' + escapeHtml(name) + '</td>' +
                                '<td>' + qty + '</td>' +
                                '<td>' + fmtVnd(rev) + '</td>' +
                                '<td class="text-end">' + sharePct.toFixed(1) + '%</td>' +
                                '<td class="text-end" style="color:' + color + '; font-weight:900; font-size:10px;">' + arrow + ' ' + Math.abs(pct).toFixed(1) + '%</td>' +
                                '</tr>';
                        }).join('');
                    } else {
                        els.topBody.innerHTML = '<tr><td colspan="6" style="opacity:.8;">No data</td></tr>';
                    }
                }
            }

            const dashboardDataUrl = '@Url.Action("DashboardData", "Portal")';
            let dashReqSeq = 0;

            function syncActiveMetric() {
                const cur = normalizeDashboardMetricKey(activeMetric);
                document.querySelectorAll('[data-dash-metric]').forEach(function (btn) {
                    const m = normalizeDashboardMetricKey(btn.getAttribute('data-dash-metric'));
                    btn.classList.toggle('dash-metric-tab--active', m === cur);
                });
            }

            function syncActiveDetail() {
                document.querySelectorAll('[data-dash-detail]').forEach(function (btn) {
                    const d = (btn.getAttribute('data-dash-detail') || '').toString().trim().toLowerCase();
                    const isActive = d === (activeDetail || '').toString().trim().toLowerCase();
                    btn.classList.toggle('dash-metric-tab--active', isActive);
                });
            }

            function preserveTableScrollTop(renderFn) {
                const container = document.querySelector('#tsDashboardRoot .ts-table-scroll');
                const prevTop = container ? container.scrollTop : 0;
                renderFn();
                if (container) container.scrollTop = prevTop;
            }

            function updateWeekTableHeader() {
                if (!els.weekTableHead) return;
                const leftHeader = activeDetail === 'week' ? 'Day' : 'Time period';
                els.weekTableHead.innerHTML = buildWeekTableHeadHtml(activeMetric, leftHeader);
            }

            function fetchAndApplyDetail() {
                const seq = ++dashReqSeq;
                const url = dashboardDataUrl + '?detailBy=' + encodeURIComponent(activeDetail);
                fetch(url, { headers: { 'Accept': 'application/json' } })
                    .then(function (res) {
                        if (!res.ok) throw new Error('DashboardData fetch failed');
                        return res.json();
                    })
                    .then(function (data) {
                        if (seq !== dashReqSeq) return;
                        preserveTableScrollTop(function () {
                            applyDashboardData(data, false);
                        });
                    })
                    .catch(function () {
                    
                    });
            }

            // Metric tab: only re-render from current series (no fetch).
            document.querySelectorAll('[data-dash-metric]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    activeMetric = normalizeDashboardMetricKey(btn.getAttribute('data-dash-metric'));
                    if (!activeMetric) activeMetric = 'sales';
                    syncActiveMetric();
                    try {
                        const u = new URL(window.location.href);
                        u.searchParams.set('metric', activeMetric);
                        u.searchParams.set('detailBy', activeDetail);
                        history.replaceState(null, '', u.pathname + u.search + u.hash);
                    } catch { /* ignore */ }
                    updateWeekTableHeader();
                    preserveTableScrollTop(function () {
                        renderForActiveMetric(latestData);
                    });
                });
            });

            // Detail tab: fetch new series for selected time bucket.
            document.querySelectorAll('[data-dash-detail]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    activeDetail = (btn.getAttribute('data-dash-detail') || '').toString().trim().toLowerCase();
                    if (!activeDetail) activeDetail = 'week';
                    syncActiveDetail();
                    updateWeekTableHeader();
                    fetchAndApplyDetail();
                });
            });

            // Ensure active styles match initial state.
            syncActiveMetric();
            syncActiveDetail();
            updateWeekTableHeader();

            applyDashboardData(initialData, true);
        })();
    </script>
</div>

